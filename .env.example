# Backend (set in Render dashboard or shell when running locally)
NODE_ENV=development
PORT=3001

# Comma-separated frontend URLs allowed in production (NODE_ENV=production).
# In development, localhost is always allowed; use * or omit for permissive dev CORS.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Dev-only admin secret for POST /api/admin/set-vip
ADMIN_SECRET=change-me
